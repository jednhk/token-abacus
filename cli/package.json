{
  "name": "token-abacus",
  "version": "0.1.0",
  "description": "Estimate what an AI coding task will cost before you run it, and record what it really cost after.",
  "type": "module",
  "bin": {
    "token-abacus": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
