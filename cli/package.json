{
  "name": "token-abacus",
  "version": "0.1.1",
  "description": "Know what an AI coding task will cost before you run it. Local MCP server for Claude Code, Codex and Cursor.",
  "type": "module",
  "bin": {
    "token-abacus": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/cli.js mcp",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "tokens",
    "cost",
    "llm",
    "budget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jednhk/token-abacus.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/jednhk/token-abacus#readme"
}
